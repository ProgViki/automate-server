// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityStatus {
  PRODUCTIVE
  IDLE
  BREAK
}

model User {
  id            String        @id @default(uuid())
  firstName     String
  lastName      String
  email         String        @unique
  phoneNumber   String        @unique
  gender        Gender
  password      String
  role          UserRole      @default(EMPLOYEE)
  avatar        String?
  createdAt     DateTime      @default(now())

  activities    Activity[]
  screenshots   Screenshot[]
  appUsages     AppUsage[]
}

model Activity {
  id            String            @id @default(uuid())
  app           String
  status        ActivityStatus
  startedAt     DateTime
  endedAt       DateTime

  userId        String
  user          User              @relation(fields: [userId], references: [id])
}

model Screenshot {
  id            String        @id @default(uuid())
  imageUrl      String
  activityLevel Int
  createdAt     DateTime      @default(now())

  userId        String
  user          User          @relation(fields: [userId], references: [id])
}

model AppUsage {
  id            String        @id @default(uuid())
  appName       String
  duration      Int
  percentage    Int
  color         String?

  userId        String
  user          User          @relation(fields: [userId], references: [id])
}