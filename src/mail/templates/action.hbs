<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>

  <body style="margin: 0">
    <center
      class="wrapper"
      style="
        width: 100%;
        table-layout: fixed;
        background-color: #eaeaea;
        padding: 25px 0px;
      "
    >
      <table
        class="main"
        width="100%"
        style="
          background-color: #fff;
          border-spacing: 0;
          width: 100%;
          max-width: 600px;
          color: #44413d;
          font-family: 'Inter', Arial, Helvetica, sans-serif;
          text-align: center;
        "
      >
        <tr>
          <td>
            <table width="100%" style="border-spacing: 0">
              <tr>
                <td style="padding: 25px 0 20px; text-align: left">
                  <a href="https://itisems.nemsa.gov.ng">
                    <div style="height: 50px; width: 100px; overflow: hidden">
                      <img
                        src="https://itisems.nemsa.gov.ng/logo-circle.png"
                        alt="logo"
                        width="10"
                        style="
                          border: 0;
                          object-fit: contain;
                          width: 100%;
                          height: 100%;
                        "
                      />
                    </div>
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <!-- Body -->
        <tr>
          <td style="padding: 0 30px">
            <table width="100%" style="border-spacing: 0">
              <tr>
                <td style="padding: 20px 0 0; text-align: left">
                  <h3
                    style="
                      font-size: 14px;
                      font-weight: 400;
                      margin: 0;
                      color: #777777;
                      line-height: 23px;
                    "
                  >
                    Dear {{name}},
                  </h3>
                  <p
                    style="
                      font-size: 14px;
                      font-weight: 400;
                      margin: 0;
                      color: #777777;
                      line-height: 23px;
                    "
                  >
                    {{message}}
                  </p>
                </td>
              </tr>
            </table>
            <table
              width="100%"
              style="
                border-spacing: 0;
                padding: 20px 0;
                border-collapse: separate;
              "
            >
              <!-- Field Row -->
              {{#each details}}
              <tr>
                <td
                  style="
                    padding: 10px 14px;
                    border: 1px solid #E9EAEB;
                    border-right: none;
                    font-weight: 400;
                    font-size: 14px;
                    color: #777;
                    text-align: left;
                    {{#if (isEven @index)}} background-color: #40B55414;{{/if}}
                    {{#if @first}}border-top-left-radius: 6px; border-top-right-radius: 6px;{{/if}}
                    {{#if @last}}border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;{{/if}}
                  "
                >
                  {{label}}
                </td>
                <td
                  style="
                    padding: 10px 14px;
                    border: 1px solid #E9EAEB;
                    border-left: none;
                    color: #262626;
                    font-weight: 600;
                    text-align: right;
                    {{#if (isEven @index)}} background-color: #40B55414;{{/if}}
                    {{#if @first}}border-top-right-radius: 6px;{{/if}}
                    {{#if @last}}border-bottom-right-radius: 6px;{{/if}}
                  "
                >
                  {{value}}
                </td>
              </tr>
              {{/each}}
            </table>
            <table style="border-spacing: 0">
              <tr>
                <td style="padding: 0; text-align: left">
                  <p
                    style="
                      font-size: 14px;
                      font-weight: 400;
                      margin: 0;
                      color: #777777;
                      line-height: 23px;
                    "
                  >
                    If you have any questions or need assistance, feel free to
                    reach out to our support team at
                    <a href="mailto:info@nemsa.gov.ng">info@nemsa.gov.ng</a>
                  </p>
                </td>
              </tr>
              <tr>
                <td style="padding: 15px 0; text-align: left">
                  <a href="{{action.link}}" style="cursor: pointer">
                    <button
                      style="
                        background-color: #00704b;
                        color: white;
                        padding: 12px 32px;
                        border: none;
                        border-radius: 5px;
                        cursor: pointer;
                      "
                    >
                      {{action.button}}
                    </button>
                  </a>
                  <p
                    style="
                      font-size: 14px;
                      font-weight: 400;
                      margin: 0;
                      color: #777777;
                      padding-top: 10px;
                      line-height: 23px;
                    "
                  >
                    {{action.instruction}}
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {{!-- Footer SECTION --}}
        <tr>
          <td style="padding: 20px 30px">
            <table width="100%" style="border-spacing: 0">
              <tr>
                <td style="text-align: center; padding: 0">
                  <p
                    style="
                      margin: 0;
                      padding-top: 10px;
                      font-weight: 400;
                      font-size: 14px;
                      color: #00000080;
                    "
                  >
                    &copy; 2025 Powered by
                    <img
                      src="https://sm.miro.zoracom.com/servicex-full-logo.png"
                      alt="miro.png"
                      width="60"
                      style="border: 0"
                    />
                    All rights reserved
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </center>
  </body>
</html>
